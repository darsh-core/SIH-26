# ============================================================
# SANKHYAI Platform - Backend Environment Configuration
# ============================================================

# Database Configuration (PostgreSQL with pgvector)
DATABASE_URL=postgresql://darshini@localhost:5433/sih_platform

# Security & Session
SECRET_KEY=supersecretkeychangeinproduction
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ============================================================
# AI & LLM Provider Configuration
# ============================================================
# Choose: "groq" (Recommended for AWS Free Tier / Fast Cloud), "ollama" (Local), or "mock"
AI_PROVIDER=groq

# Groq Cloud API Key (Get free key from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Local Ollama Configuration (Only needed if AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_TIMEOUT=120

# Vector Embeddings
EMBEDDING_PROVIDER=sentence_transformer
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Learning Provider Mode
LEARNING_PROVIDER=demo
